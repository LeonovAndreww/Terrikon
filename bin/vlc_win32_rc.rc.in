#define VERSION_NUMBER @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_REVISION@,@VERSION_EXTRA@
#define VERSION_NUMBER_STR "@VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_REVISION@,@VERSION_EXTRA@"

#include <winuser.h>

VLC_ICON ICON "vlc.ico"

1 VERSIONINFO
FILETYPE 1
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Terrikon"
      VALUE "ProductName", "Terrikon"
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "InternalName", "terrikon"
      VALUE "OriginalFilename", "vlc.exe"
      VALUE "FileVersion", "@VERSION@"
      VALUE "FileDescription", "Terrikon"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors, Terrikon authors"
      VALUE "LegalTrademarks", "VLC and VideoLAN are trademarks of VideoLAN. Terrikon is not affiliated with VideoLAN."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vlc.exe.manifest"
